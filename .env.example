# ElevenLabs API key — required for STT (Scribe v3) and TTS (Eleven v3)
ELEVENLABS_API_KEY=

# Local server port (Node host)
PORT=8787

# ----------------------------------------------------------------------------
# Voice IDs — pick Tamil-capable voices from the ElevenLabs Voice Library
# (https://elevenlabs.io/app/voice-library → language filter: Tamil).
# Env vars override src/core/packs/tamil.ts entries.
# ----------------------------------------------------------------------------
VOICE_CUSTOMS_OFFICER=
VOICE_TAXI_DRIVER=
VOICE_ELDER_HOST=
VOICE_COUSIN=
VOICE_WAITER=
VOICE_SHOPKEEPER=
# Voice used for Inspect Line "Play Native Tamil" + word drill clips
VOICE_NARRATOR=
